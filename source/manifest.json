{
  "manifest_version": 3,
  "name": "繪師去哪了 助手",
  "version": "1.1.0",
  "description": "在繪師的個人頁面一鍵偵測他的各平台帳號，確認後加入「繪師去哪了」資料庫。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://artistwhere.com/*",
    "http://localhost:3000/*",
    "https://booth.pm/*",
    "https://*.booth.pm/*",
    "https://nekolive.net/*",
    "https://*.nekolive.net/*",
    "https://ganknow.com/*",
    "https://*.ganknow.com/*",
    "https://dlsite.com/*",
    "https://www.dlsite.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "content/twitter.js"
      ]
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "content/facebook.js"
      ]
    },
    {
      "matches": [
        "https://www.pixiv.net/*",
        "https://pixiv.net/*"
      ],
      "js": [
        "content/pixiv.js"
      ]
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "content/instagram.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
